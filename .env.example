# ─────────────────────────────────────────────────────────────
# StuffSearch environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only EXPO_PUBLIC_* vars are bundled into the app. Secrets stay server-side.
# ─────────────────────────────────────────────────────────────

# Supabase project (client-safe values from Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=stuffsearch

# ── Supabase Edge Function secrets (set via Supabase CLI, NOT in app) ──
# Run these after `supabase link`:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set PRODUCT_LOOKUP_PROVIDER=off  # off | off | upcitemdb
#   supabase secrets set UPCITEMDB_API_KEY=           # only if provider=upcitemdb
# These are referenced by the Deno functions in supabase/functions/.

# ── Apple Universal Links / Android App Links (for deep-linking) ──
# Configure when you own a domain. The app deep-link scheme `stuffsearch://`
# works without a domain for local / Expo Go testing.
