# ─────────────────────────────────────────────────────────────
# StuffSearch environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Only EXPO_PUBLIC_* vars are bundled into the app. Secrets stay server-side.
# ─────────────────────────────────────────────────────────────

# Supabase project (client-safe values from Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
# Supabase now issues PUBLISHABLE keys (sb_publishable_…) through JWT Signing
# Keys and has deprecated the legacy anon JWT. Either works here — the variable
# name is only ours; it is the value Supabase validates.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# Server-side only, never bundled into the app. Used by `npm run backup`.
# Supabase now issues SECRET keys (sb_secret_…) through JWT Signing Keys and has
# deprecated the legacy service_role JWT. SUPABASE_SECRET_KEY is preferred;
# SUPABASE_SERVICE_ROLE_KEY is still read for older .env files.
# Project Settings -> API Keys -> Secret keys -> reveal, or create a new one.
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY
EXPO_PUBLIC_SUPABASE_STORAGE_BUCKET=stuffsearch

# ── Supabase Edge Function secrets (set via Supabase CLI, NOT in app) ──
# Run these after `supabase link`:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase secrets set PRODUCT_LOOKUP_PROVIDER=off  # off | off | upcitemdb
#   supabase secrets set UPCITEMDB_API_KEY=           # only if provider=upcitemdb
# These are referenced by the Deno functions in supabase/functions/.

# ── Apple Universal Links / Android App Links (for deep-linking) ──
# Configure when you own a domain. The app deep-link scheme `stuffsearch://`
# works without a domain for local / Expo Go testing.
